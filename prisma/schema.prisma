generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Branche {
  FUGEN
  FLIESEN
  GALABAU
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  users     User[]
  projects  Project[]
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  passwordHash   String
  name           String?
  role           String       @default("member") // "owner" | "member"
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  entries        Entry[]
}

model Project {
  id             String       @id @default(cuid())
  name           String
  branche        Branche
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entries        Entry[]
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model Entry {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  etage      String
  raum       String
  position   String
  formel     String
  menge      Float
  einheit    String
  mitarbeiterId String?
  mitarbeiter User?   @relation(fields: [mitarbeiterId], references: [id])
  mitarbeiterName String?
  datum      String
  createdAt  DateTime @default(now())

  @@index([projectId])
}
